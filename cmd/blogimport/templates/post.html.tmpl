<!doctype html>
<html class="no-js" lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>{{.Title}} · PCS VoIP Blog</title>
    <meta name="description" content="{{.Excerpt}}">
    <link rel="icon" type="image/png" href="/assets/img/favicon-pcs.png">

    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,700&amp;family=Roboto:wght@300;400;500;700;900&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/css/fontawesome.min.css">
    <link rel="stylesheet" href="/assets/css/magnific-popup.min.css">
    <link rel="stylesheet" href="/assets/css/swiper-bundle.min.css">
    <link rel="stylesheet" href="/assets/css/style2.css">
    <link rel="stylesheet" href="/assets/css/pegasi-ai.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/chatbot.css">
    <style>
        .blog-article { max-width: 820px; margin: 0 auto; }
        .blog-article .blog-cover { width: 100%; height: auto; border-radius: 8px; margin-bottom: 28px; box-shadow: 0 8px 24px rgba(20,29,56,0.08); }
        .blog-article .blog-meta { color: #6c7689; font-size: 0.9rem; margin-bottom: 24px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
        .blog-article .blog-meta .meta-pill { background: rgba(103,189,74,0.12); color: #4a9633; padding: 4px 10px; border-radius: 999px; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.4px; }
        .blog-article h1.blog-title { font-size: clamp(1.9rem, 3.6vw, 2.7rem); font-weight: 800; color: #141D38; margin-bottom: 18px; line-height: 1.2; }
        .blog-article .blog-body { font-size: 1.05rem; line-height: 1.75; color: #2b3242; }
        .blog-article .blog-body h2, .blog-article .blog-body h3, .blog-article .blog-body h4 { color: #141D38; margin-top: 1.6em; margin-bottom: 0.6em; font-weight: 700; }
        .blog-article .blog-body h2 { font-size: 1.6rem; }
        .blog-article .blog-body h3 { font-size: 1.3rem; }
        .blog-article .blog-body h4 { font-size: 1.12rem; }
        .blog-article .blog-body p { margin-bottom: 1.1em; }
        .blog-article .blog-body img { max-width: 100%; height: auto; border-radius: 6px; margin: 12px 0; }
        .blog-article .blog-body ul, .blog-article .blog-body ol { padding-left: 1.4em; margin-bottom: 1.2em; }
        .blog-article .blog-body li { margin-bottom: 0.4em; }
        .blog-article .blog-body a { color: #67bd4a; text-decoration: underline; }
        .blog-article .blog-body a:hover { color: #4a9633; }
        .blog-article .blog-body blockquote { border-left: 4px solid #67bd4a; padding: 8px 18px; margin: 18px 0; background: #fafbfc; color: #495160; }
        .blog-nav { display: flex; justify-content: space-between; align-items: stretch; gap: 16px; margin-top: 56px; padding-top: 28px; border-top: 1px solid #e4e8ee; }
        .blog-nav a { flex: 1 1 0; padding: 14px 18px; border: 1px solid #e4e8ee; border-radius: 8px; text-decoration: none; color: #141D38; transition: border-color 0.15s, transform 0.15s; max-width: 48%; }
        .blog-nav a:hover { border-color: #67bd4a; transform: translateY(-1px); }
        .blog-nav a.next { text-align: right; }
        .blog-nav .nav-label { color: #6c7689; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; }
        .blog-nav .nav-title { display: block; margin-top: 6px; font-weight: 600; color: #141D38; }
        .blog-back { display: inline-block; margin-bottom: 18px; color: #6c7689; text-decoration: none; }
        .blog-back:hover { color: #67bd4a; }
    </style>
</head>
<body>
{{template "site_header"}}
{{template "site_breadcrumb" .Title}}

<section class="space-top space-extra-bottom">
    <div class="container">
        <article class="blog-article">
            <a href="./index.html" class="blog-back"><i class="fas fa-arrow-left me-2"></i>Back to all posts</a>
            <h1 class="blog-title">{{.Title}}</h1>
            <div class="blog-meta">
                <span class="meta-pill"><i class="fas fa-tag me-1"></i>Blog</span>
                <span><i class="far fa-calendar me-1"></i><time datetime="{{.DateISO}}">{{.DateText}}</time></span>
                <span><i class="far fa-user me-1"></i>{{.Author}}</span>
            </div>
            {{if .Cover}}<img class="blog-cover" src="{{.Cover}}" alt="{{.CoverAlt}}">{{end}}
            <div class="blog-body">{{.Body}}</div>
            {{if or .PrevURL .NextURL}}
            <nav class="blog-nav">
                {{if .PrevURL}}
                <a href="{{.PrevURL}}" class="prev">
                    <span class="nav-label"><i class="fas fa-arrow-left me-1"></i>Previous</span>
                    <span class="nav-title">{{.PrevTitle}}</span>
                </a>
                {{else}}<span></span>{{end}}
                {{if .NextURL}}
                <a href="{{.NextURL}}" class="next">
                    <span class="nav-label">Next<i class="fas fa-arrow-right ms-1"></i></span>
                    <span class="nav-title">{{.NextTitle}}</span>
                </a>
                {{else}}<span></span>{{end}}
            </nav>
            {{end}}
        </article>
    </div>
</section>

{{template "site_footer"}}
{{template "site_scripts"}}
</body>
</html>
