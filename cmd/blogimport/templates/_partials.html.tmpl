<div id="chatbot-icon" onclick="toggleChatbot()"><i class="fas fa-comments"></i></div>
<div class="chatbot-overlay" id="chatbot-overlay"></div>
<div id="chatbot-window">
    <div id="chatbot-header">
        <span>Pegasi</span>
        <div class="header-buttons">
            <button class="header-btn phone-btn" onclick="initiateCall()"><i class="fas fa-phone"></i></button>
            <button class="close-btn" onclick="closeChatbot()">End Chat</button>
        </div>
    </div>
    <div id="chatbot-body">
        <div id="chat-messages"></div>
        <div id="user-form" class="user-form">
            <input type="text" id="user-first-name" placeholder="First Name *" required>
            <input type="text" id="user-last-name" placeholder="Last Name *" required>
            <input type="tel" id="user-phone" placeholder="Phone Number *" required>
            <input type="email" id="user-email" placeholder="Email (optional)">
            <button onclick="startChat()">Start Chat</button>
        </div>
    </div>
    <div id="voice-mode">
        <div class="voice-orb" onclick="startVoiceSession()"><i class="fas fa-microphone"></i></div>
        <div class="voice-status" id="voice-status">Click to start</div>
        <div class="voice-transcript" id="voice-transcript"></div>
        <button class="voice-end-btn" onclick="endVoiceSession()">End Voice Chat</button>
    </div>
    <div id="chatbot-footer">
        <input type="text" id="chatbot-input" placeholder="Type your message..." onkeypress="handleKeyPress(event)">
        <button id="send-btn" onclick="submitChatMessage()" title="Send"><i class="fas fa-paper-plane"></i></button>
        <button id="voice-start-btn" onclick="startVoiceSession()" title="Talk to Pegasi"><i class="fas fa-microphone"></i></button>
    </div>
</div>

<script src="/assets/js/chatbot.js"></script>{{end}}
